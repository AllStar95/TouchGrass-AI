# TouchGrass AI - Backend Environment Configuration

# Server settings
PORT=8000
HOST=0.0.0.0

# Ollama local connection
OLLAMA_BASE_URL=http://localhost:11434

# Selected Google Gemma Model (recommended: gemma2:2b for fast, high-quality, lightweight offline generation)
# Other compatible options: gemma2:9b, gemma:2b, gemma:7b
GEMMA_MODEL=gemma2:2b

# Ollama API timeout in seconds (Gemma 2 2B usually takes 2-8s, larger models or slow CPUs may take longer)
OLLAMA_TIMEOUT_SECONDS=60
